# URL base da API FastAPI do C-Trip (sem barra final). Lida por constants/api_base.ts
# e injetada como baseURL do cliente Axios.
#
# NÃO precisas de definir isto — já está fixado por ambiente em .env.development
# (localhost:8000) e .env.production (ctrip.electrosoftwares.com), ambos versionados.
# Só cria uma NEXT_PUBLIC_BASE_API_URL num .env.local (ou nas env vars da Vercel) se
# quiseres apontar o teu ambiente a um backend diferente do padrão.
# NEXT_PUBLIC_BASE_API_URL=http://localhost:8000

# Necessário para o backend aceitar "Continuar com Google" em POST /auth/google.
# Sem isto o backend devolve 503 — o botão fica desactivado no login até isto existir.
# GOOGLE_CLIENT_ID=
