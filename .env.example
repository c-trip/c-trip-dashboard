# URL base da API FastAPI do C-Trip (sem barra final).
# É lida por constants/api_base.ts e injetada como baseURL do cliente Axios.
NEXT_PUBLIC_BASE_API_URL=http://localhost:8000

# Necessário para o backend aceitar "Continuar com Google" em POST /auth/google.
# Sem isto o backend devolve 503 — o botão fica desactivado no login até isto existir.
# GOOGLE_CLIENT_ID=
