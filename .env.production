# Carregado automaticamente pelo Next.js quando NODE_ENV=production (next build,
# incluindo o build feito pela Vercel). Não é segredo (é só a URL pública da API),
# por isso fica versionado — o deploy de produção usa sempre esta URL por defeito,
# mesmo que ninguém tenha configurado NEXT_PUBLIC_BASE_API_URL no dashboard da Vercel.
#
# Se um dia for preciso apontar um deploy específico para outro backend, define
# NEXT_PUBLIC_BASE_API_URL nas Environment Variables da Vercel — isso tem
# prioridade sobre este ficheiro.
NEXT_PUBLIC_BASE_API_URL=https://ctrip.electrosoftwares.com
